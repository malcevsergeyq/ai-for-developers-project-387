# Адрес бэкенда. Локально с реальным сервером — http://127.0.0.1:3000 (это значение уже
# лежит в .env.development), с моком Prism вместо бэка — http://127.0.0.1:4010.
# В образе переменная пустая: там фронт и API отдаются с одного origin.
#
# Адрес именно 127.0.0.1, а не localhost: на Windows localhost резолвится в ::1,
# а сервер слушает IPv4.
VITE_API_URL=http://127.0.0.1:3000
